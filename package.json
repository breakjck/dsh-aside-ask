{
  "name": "dsh-aside-ask",
  "version": "0.1.0",
  "private": true,
  "description": "旁问：在对话记录里圈出一段，右键直接问一个小问题，答案走旁支子对话，不打断主对话。A DSH plugin for side-questions on selected text.",
  "type": "module",
  "license": "MIT",
  "author": "breakjck",
  "homepage": "https://github.com/breakjck/dsh-aside-ask#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/breakjck/dsh-aside-ask.git"
  },
  "bugs": {
    "url": "https://github.com/breakjck/dsh-aside-ask/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "aside",
    "subagent",
    "context-menu",
    "selection"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
