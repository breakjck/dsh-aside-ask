{
  "name": "dsh-aside-ask",
  "version": "0.2.1",
  "private": true,
  "description": "鏃侀棶锛氬湪瀵硅瘽璁板綍閲屽湀鍑轰竴娈碉紝鍙抽敭鐩存帴闂竴涓皬闂锛岀瓟妗堣蛋鏃佹敮瀛愬璇濓紝涓嶆墦鏂富瀵硅瘽銆侫 DSH plugin for side-questions on selected text.",
  "type": "module",
  "license": "MIT",
  "author": "breakjck",
  "homepage": "https://github.com/breakjck/dsh-aside-ask#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/breakjck/dsh-aside-ask.git"
  },
  "bugs": {
    "url": "https://github.com/breakjck/dsh-aside-ask/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "aside",
    "subagent",
    "context-menu",
    "selection"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
